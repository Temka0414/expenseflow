# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
dist/
frontend/dist-mock/
frontend/dist-pages/
*.tsbuildinfo
coverage/
npm-debug.log*

# Generated by scripts/write_frontend_config.py from YOUR stack outputs.
# Deployed sites get their own copy from the Frontend stack instead.
frontend/public/config.json

# ---------------------------------------------------------------------------
# AWS CDK
# ---------------------------------------------------------------------------
# The cloud assembly (templates + bundled assets) is rebuilt on every synth.
cdk.out/
infra/cdk.out/
# NOTE: cdk.context.json is deliberately NOT ignored. CDK caches context lookups
# (AZs, AMIs, ...) there and recommends committing it so synth stays deterministic.

# ---------------------------------------------------------------------------
# Secrets and local environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Scratch files of the AI-assisted build process
# ---------------------------------------------------------------------------
.finish-workflow.js
.build-workflow.js

