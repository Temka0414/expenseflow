@page "{id:int}"
@model DeleteModel
@{
    ViewData["Title"] = "Delete asset";
}

<h1>Delete asset</h1>

<p>Delete <strong>@Model.Asset.Name</strong> (@Model.Asset.Category)? This cannot be undone.</p>

<form method="post">
    <div class="actions">
        <button type="submit" class="danger">Delete</button>
        <a asp-page="Index">Cancel</a>
    </div>
</form>
