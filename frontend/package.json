{
  "name": "expenseflow-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock --outDir dist-mock",
    "build:pages": "tsc -b && vite build --mode mock --outDir dist-pages",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:mock": "vite preview --mode mock --outDir dist-mock",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "6.15.6",
    "aws-amplify": "6.22.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "@xstate/react": {
      "react": "$react"
    }
  }
}
