# https://editorconfig.org - shared formatting basics for every editor/IDE.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# Windows PowerShell 5.1 is happiest with CRLF (matches .gitattributes).
[*.{ps1,psm1,psd1}]
end_of_line = crlf
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
